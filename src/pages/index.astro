---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('blog');
const sortedPosts = posts.sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime());
const featuredPosts = sortedPosts.slice(0, 6);
const remainingPosts = sortedPosts.slice(6, 40);
---

<Layout title="Real Estate Saint-Barthélemy — Propriétés de Prestige & Villas Vue Mer">
  <!-- Hero Section Aubergine -->
  <section class="relative border-b border-purple-950/60 bg-zinc-950 py-16 sm:py-24 overflow-hidden">
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top,rgba(88,28,135,0.18),transparent_60%)]"></div>
    <div class="relative mx-auto max-w-7xl px-4 sm:px-6">
      
      <!-- Top Pill -->
      <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-purple-500/30 bg-purple-950/40 px-3.5 py-1.5 text-xs text-purple-200">
        <span class="h-2 w-2 rounded-full bg-amber-400"></span>
        COLLECTIVITÉ D'OUTRE-MER DE SAINT-BARTHÉLEMY
      </div>

      <!-- Headline -->
      <h1 class="font-serif text-3xl font-extrabold tracking-tight text-zinc-100 sm:text-5xl lg:text-6xl max-w-4xl leading-tight">
        L'Immobilier de Grand Luxe à <span class="text-amber-300 italic font-serif">Saint-Barthélemy</span>.
      </h1>

      <p class="mt-6 max-w-2xl text-base sm:text-lg text-zinc-300 leading-relaxed font-light">
        Villas d'exception pieds dans l'eau, propriétés confidentielles avec vue mer panoramique, fiscalité territoriale et expertise pour acquéreurs exigeants.
      </p>

      <!-- Key Pillars Row -->
      <div class="mt-12 grid grid-cols-2 gap-4 sm:grid-cols-4 lg:gap-6">
        <div class="rounded-xl border border-purple-900/30 bg-zinc-900/50 p-5 backdrop-blur-sm">
          <div class="text-[11px] text-amber-300 uppercase tracking-widest font-semibold">Micro-Marché</div>
          <div class="mt-2 font-serif text-2xl font-bold text-zinc-100">Ultra-Exclusif</div>
          <div class="mt-1 text-xs text-zinc-400">Offre rare et préservée</div>
        </div>
        <div class="rounded-xl border border-purple-900/30 bg-zinc-900/50 p-5 backdrop-blur-sm">
          <div class="text-[11px] text-amber-300 uppercase tracking-widest font-semibold">Fiscalité COM</div>
          <div class="mt-2 font-serif text-2xl font-bold text-purple-300">Article 74</div>
          <div class="mt-1 text-xs text-zinc-400">Exonérations après 5 ans</div>
        </div>
        <div class="rounded-xl border border-purple-900/30 bg-zinc-900/50 p-5 backdrop-blur-sm">
          <div class="text-[11px] text-amber-300 uppercase tracking-widest font-semibold">Secteurs Phares</div>
          <div class="mt-2 font-serif text-2xl font-bold text-zinc-100">Saint-Jean</div>
          <div class="mt-1 text-xs text-zinc-400">Gustavia, Flamands, Saline</div>
        </div>
        <div class="rounded-xl border border-purple-900/30 bg-zinc-900/50 p-5 backdrop-blur-sm">
          <div class="text-[11px] text-amber-300 uppercase tracking-widest font-semibold">Sécurité Actes</div>
          <div class="mt-2 font-serif text-2xl font-bold text-amber-300">100% Notarié</div>
          <div class="mt-1 text-xs text-zinc-400">Droit civil et garantie de titre</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Featured Bento Articles -->
  <section class="py-16 sm:py-20 bg-zinc-950 border-b border-purple-950/60">
    <div class="mx-auto max-w-7xl px-4 sm:px-6">
      <div class="flex items-center justify-between mb-10">
        <div>
          <span class="text-xs uppercase tracking-widest text-amber-300 font-semibold">Conseil & Propriétés</span>
          <h2 class="font-serif text-2xl font-bold text-zinc-100 sm:text-3xl mt-1">Dernières Études et Analyses de Marché</h2>
        </div>
        <a href="/blog/" class="hidden sm:inline-flex items-center gap-2 text-xs text-amber-300 hover:text-amber-200 font-medium">
          VOIR TOUS LES RAPPORTS →
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {featuredPosts.map((post) => (
          <article class="group relative flex flex-col justify-between rounded-xl border border-purple-950/60 bg-zinc-900/40 p-6 transition-all duration-300 hover:border-purple-500/40 hover:bg-zinc-900/70">
            <div>
              <div class="flex items-center justify-between text-[11px] text-zinc-400 mb-3">
                <span class="rounded bg-purple-950/80 px-2 py-0.5 text-amber-300 font-medium">{post.data.category || 'Propriété'}</span>
                <span>{new Date(post.data.pubDate).toLocaleDateString('fr-FR', { year: 'numeric', month: 'short', day: 'numeric' })}</span>
              </div>
              <h3 class="font-serif text-xl font-bold text-zinc-100 group-hover:text-amber-300 transition-colors line-clamp-2 leading-snug">
                <a href={'/blog/' + post.id + '/'}>
                  {post.data.title}
                </a>
              </h3>
              <p class="mt-3 text-xs text-zinc-400 line-clamp-3 leading-relaxed">
                {post.data.description}
              </p>
            </div>
            <div class="mt-6 pt-4 border-t border-zinc-800/80 flex items-center justify-between text-xs">
              <span class="text-zinc-500">Saint-Barth Advisory</span>
              <a href={'/blog/' + post.id + '/'} class="text-amber-300 hover:underline flex items-center gap-1 font-medium">
                Lire l'analyse →
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Extended Library -->
  <section class="py-16 bg-zinc-900/20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6">
      <h2 class="font-serif text-2xl font-bold text-zinc-100 mb-8">
        Conseils d'Acquisition, Fiscalité & Art de Vivre
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        {remainingPosts.map(post => (
          <div class="flex items-start justify-between rounded-lg border border-zinc-800 bg-zinc-900/40 p-4 hover:border-purple-900/60 transition-colors">
            <div class="pr-4">
              <span class="text-[10px] text-amber-300 uppercase tracking-wider font-semibold">{post.data.category || 'Dossier'}</span>
              <h4 class="text-sm font-medium text-zinc-200 mt-1 hover:text-amber-200 transition-colors">
                <a href={'/blog/' + post.id + '/'}>{post.data.title}</a>
              </h4>
            </div>
            <a href={'/blog/' + post.id + '/'} class="text-xs text-amber-300 whitespace-nowrap pt-1 font-medium">
              Lire →
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>
</Layout>
