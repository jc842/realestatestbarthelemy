---
import ReviveSlot from '../../components/ads/ReviveSlot.astro';
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map(post => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<Layout title={post.data.title + ' — Real Estate Saint-Barth'} description={post.data.description}>
  <article class="py-12 bg-zinc-950">
    <div class="mx-auto max-w-4xl px-4 sm:px-6">
      
      <!-- Breadcrumb -->
      <div class="flex items-center gap-2 text-xs text-zinc-400 mb-6 font-medium">
        <a href="/" class="hover:text-amber-300">Accueil</a>
        <span>/</span>
        <a href="/blog/" class="hover:text-amber-300">Dossiers</a>
        <span>/</span>
        <span class="text-amber-300">{post.data.category || 'Immobilier'}</span>
      </div>

      <!-- Header -->
      <header class="border-b border-purple-950/60 pb-8 mb-8">
        <span class="text-xs uppercase tracking-widest text-amber-300 font-semibold mb-3 block">SAINT-BARTHÉLEMY ADVISORY</span>
        <h1 class="font-serif text-2xl sm:text-4xl font-extrabold text-zinc-100 tracking-tight leading-tight">
          {post.data.title}
        </h1>
        <div class="mt-4 flex items-center gap-4 text-xs text-zinc-400">
          <span>Publié le {new Date(post.data.pubDate).toLocaleDateString('fr-FR', { year: 'numeric', month: 'long', day: 'numeric' })}</span>
          <span>•</span>
          <span>Équipe Éditoriale Saint-Barth</span>
        </div>
      </header>

      <!-- Content -->
      <div class="prose prose-invert prose-zinc max-w-none prose-headings:font-serif prose-headings:text-zinc-100 prose-a:text-amber-300 leading-relaxed text-zinc-300">
        <Content />

      <!-- Encart Pub In-Content Revive (Medium Rectangle) -->
      <div class="my-12 py-6 border-y border-stone-200/80 dark:border-stone-800 flex justify-center">
        <ReviveSlot slot="inContent" />
      </div>

      <!-- Encart Pub Fin d'Article Large Rectangle -->
      <div class="my-8 p-4 bg-stone-50/60 dark:bg-stone-900/60 rounded-2xl border border-stone-200/60 dark:border-stone-800 flex flex-col items-center justify-center text-center">
        <ReviveSlot slot="largeRectangle" />
      </div>
      </div>

      <!-- Footer -->
      <footer class="mt-12 border-t border-zinc-800 pt-8 text-xs flex justify-between items-center text-zinc-400">
        <a href="/blog/" class="text-amber-300 hover:underline font-medium">← Retour aux dossiers</a>
        <span>Real Estate Saint-Barthélemy Excellence</span>
      </footer>
    </div>
  </article>
</Layout>
