---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('blog');
const sortedPosts = posts.sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime());
---

<Layout title="Tous les Rapports et Études Immobilières à Saint-Barth — Real Estate St-Barth">
  <section class="border-b border-purple-950/60 bg-zinc-950 py-12">
    <div class="mx-auto max-w-7xl px-4 sm:px-6">
      <div class="inline-flex items-center gap-2 rounded-full border border-purple-500/30 bg-purple-950/40 px-3 py-1 text-xs text-purple-200 mb-4">
        CATALOGUE DES PUBLICATIONS
      </div>
      <h1 class="font-serif text-3xl font-extrabold text-zinc-100 sm:text-4xl">Tous les Articles & Dossiers Saint-Barth</h1>
      <p class="mt-3 max-w-2xl text-zinc-400 text-sm">
        Explorez nos 200 fiches pratiques, études patrimoniales et guides d'acquisition de villas à Saint-Barthélemy.
      </p>
    </div>
  </section>

  <section class="py-12 bg-zinc-950">
    <div class="mx-auto max-w-7xl px-4 sm:px-6">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {sortedPosts.map(post => (
          <article class="flex flex-col justify-between rounded-xl border border-zinc-800 bg-zinc-900/50 p-6 hover:border-purple-500/50 transition-colors">
            <div>
              <div class="flex items-center justify-between text-[11px] text-zinc-400 mb-3">
                <span class="rounded bg-purple-950 px-2 py-0.5 text-amber-300 font-medium">{post.data.category || 'Article'}</span>
                <span>{new Date(post.data.pubDate).toLocaleDateString('fr-FR', { year: 'numeric', month: 'short', day: 'numeric' })}</span>
              </div>
              <h2 class="font-serif text-lg font-bold text-zinc-100 hover:text-amber-300 transition-colors line-clamp-2">
                <a href={'/blog/' + post.id + '/'}>{post.data.title}</a>
              </h2>
              <p class="mt-2 text-xs text-zinc-400 line-clamp-3 leading-relaxed">
                {post.data.description}
              </p>
            </div>
            <div class="mt-5 pt-4 border-t border-zinc-800 flex justify-end text-xs">
              <a href={'/blog/' + post.id + '/'} class="text-amber-300 hover:underline font-medium">
                Lire l'article →
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</Layout>
