---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('blog-en');
---

<Layout title="Real Estate Saint-Barthélemy — Luxury Villas & Private Estates in St. Barts" lang="en">
  <section class="border-b border-purple-950/60 bg-zinc-950 py-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6">
      <div class="inline-flex items-center gap-2 rounded-full border border-purple-500/30 bg-purple-950/40 px-3.5 py-1 text-xs text-purple-200 mb-4">
        ST. BARTS LUXURY HUB
      </div>
      <h1 class="font-serif text-3xl font-extrabold text-zinc-100 sm:text-5xl">Luxury Real Estate & Private Estates in St. Barts</h1>
      <p class="mt-4 max-w-2xl text-zinc-300 text-sm sm:text-base leading-relaxed font-light">
        Private wealth advisory for prime villa acquisitions, Article 74 fiscal residency frameworks, and conveyancing across Gustavia, Saint-Jean, and Flamands.
      </p>
    </div>
  </section>

  <section class="py-12 bg-zinc-950">
    <div class="mx-auto max-w-7xl px-4 sm:px-6">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {posts.map(post => (
          <article class="flex flex-col justify-between rounded-xl border border-zinc-800 bg-zinc-900/50 p-6 hover:border-purple-500/50 transition-colors">
            <div>
              <span class="rounded bg-purple-950 px-2 py-0.5 text-[11px] text-amber-300 font-semibold">{post.data.category}</span>
              <h2 class="font-serif text-lg font-bold text-zinc-100 mt-3 hover:text-amber-300 transition-colors">
                <a href={'/en/' + post.id + '/'}>{post.data.title}</a>
              </h2>
              <p class="mt-2 text-xs text-zinc-400 leading-relaxed">
                {post.data.description}
              </p>
            </div>
            <div class="mt-6 pt-4 border-t border-zinc-800 text-xs">
              <a href={'/en/' + post.id + '/'} class="text-amber-300 hover:underline font-medium">Read Report →</a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</Layout>
